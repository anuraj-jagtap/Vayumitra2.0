# ML Forecasting Engine Environment Configuration

# Database Connection (AWS RDS Aurora / PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vayumitra
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSLMODE=prefer

# External API Keys for Live Meteorological & Pollutant Features
OPENWEATHER_API_KEY=your_openweather_api_key_here  # Real-time weather observation from OpenWeather (lat: 28.61, lon: 77.21)
WAQI_API_KEY=your_waqi_api_key_here                # Live station readings across Delhi from WAQI (api.waqi.info)
XKDR_API_KEY=your_xkdr_api_key_here                # (Optional) XKDR CPCB live pollutant feed (airquality.xkdr.org/v1)

# Server Configuration
ML_API_HOST=0.0.0.0
ML_API_PORT=8001
