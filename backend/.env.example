# External Meteorology & Air Quality Model API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here # OpenWeatherMap API key for live temperature, humidity, wind & dispersion features
WAQI_API_KEY=your_waqi_api_key_here               # WAQI/AQICN token for live station AQI observations across Delhi NCR
XKDR_API_KEY=your_xkdr_api_key_here               # (Optional) XKDR CPCB API token for real-time station lag features
CPCB_API_KEY=your_cpcb_datagov_api_key            # (Optional) data.gov.in CPCB API key
OPENAQ_API_KEY=your_openaq_api_key                # (Optional) OpenAQ v3 API key

# Citizen AQI Provider Configuration
AQI_PROVIDER=aqicn                                # 'aqicn', 'cpcb', 'openaq', or 'demo'
AQI_API_KEY=your_waqi_api_key_here               # API key for the active provider
AQI_CACHE_SECONDS=900                             # Cache frequency: 900 for 15-min updates, 3600 for hourly

# Citizen ML Forecasting Service
ML_API_BASE_URL=http://localhost:8001